  # Copy this file to srcs/.env and replace every value.
  # srcs/.env is ignored by Git: never commit real credentials.
  #
  #   cp srcs/.env.example srcs/.env
  #
  # NOTE: srcs/requirements/wordpress/conf/wp-config.php must use the same
  # database name, user and password as the values below.

  MYSQL_ROOT_PASSWORD=change_me_root_password
  MYSQL_DATABASE=change_me_database
  MYSQL_USER=change_me_user
  MYSQL_PASSWORD=change_me_password
